[Unit]
Description=openvpn-wm customer DNS policy gateway (:53 on VPN)
After=network.target openvpn@server.service
Requires=openvpn@server.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /etc/openvpn/scripts/dns-policy.py 10.8.0.1 127.0.0.1 53
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
