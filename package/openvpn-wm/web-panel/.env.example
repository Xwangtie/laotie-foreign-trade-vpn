# ============ 老铁外贸网络管理系统 ============
# 复制为 web-panel/.env 并按部署环境修改；生产环境严禁提交 .env

# ---- 品牌 ----
APP_NAME=老铁外贸网络管理系统
SUPPORT_PHONE=13905394878
SUPPORT_EMAIL=ymwww@qq.com

# ---- 数据库 ----
# 开发/测试可用相对或绝对路径；生产统一放 /var/lib/openvpn-wm/panel.db
OPENVPN_WM_DB_PATH=/var/lib/openvpn-wm/panel.db

# ---- S1 CLI 与路径（无服务端时 MOCK_EASY_RSA=true 走模拟）----
MOCK_EASY_RSA=false
OPENVPN_WM_PROFILES_DIR=
OPENVPN_WM_CCD_DIR=/etc/openvpn/ccd
S1_USE_SUDO=true
GEN_CCD_SCRIPT=/etc/openvpn/scripts/gen-ccd.sh
GEN_CLIENT_SCRIPT=/etc/openvpn/scripts/gen-client.sh
REVOKE_CLIENT_SCRIPT=/etc/openvpn/scripts/revoke-client.sh
LIST_CLIENTS_SCRIPT=/etc/openvpn/scripts/list-clients.sh
SUSPEND_CCD_SCRIPT=/etc/openvpn/scripts/suspend-client.sh
VPN_KILL_SCRIPT=/etc/openvpn/scripts/vpn-kill.sh
OPENVPN_STATUS_LOG=/var/log/openvpn/status.log
PORTMAP_SCRIPT=/etc/openvpn/scripts/portmap.sh
LOG_CLEAN_SCRIPT=/etc/openvpn/scripts/log-clean.sh

# ---- JWT 认证（生产必须改为足够长的随机值）----
JWT_SECRET=please-change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
TOTP_ISSUER=老铁外贸网络管理系统
# 管理端当前阶段是否强制 TOTP 扫码：false = 先不要求绑定
REQUIRE_TOTP=false

# 首次启动若没有管理员，可用此密码自动创建 superadmin（admin）；
# 留空则必须执行: python -m app.cli create-admin
BOOTSTRAP_ADMIN_PASSWORD=

# ---- SMTP 到期提醒（未配置时任务优雅跳过，不崩）----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ymwww@qq.com
SMTP_FROM_NAME=老铁外贸网络管理系统
SMTP_USE_SSL=true

# ---- 默认节点（新服务器安装时改为实际域名/IP）----
DEFAULT_NODE_NAME=节点1
DEFAULT_NODE_REGION=中国
DEFAULT_NODE_DOMAIN=vpn.example.com
DEFAULT_NODE_IP=127.0.0.1
DEFAULT_NODE_SSH_PORT=22
DEFAULT_NODE_OPENVPN_PORT=1194

# ---- 定时任务开关 ----
ENABLE_SCHEDULER=true
# 是否生成/发送到期邮件提醒：false = 先暂停
ENABLE_EMAIL_REMINDERS=false
